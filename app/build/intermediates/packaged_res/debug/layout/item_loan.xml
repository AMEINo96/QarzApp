<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLoanDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loan Description"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/tvLoanContext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You lent them"
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvLoanUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UID: loading..."
                        android:textSize="10sp"
                        android:textColor="#9E9E9E"/>

                    <ImageView
                        android:id="@+id/ivCopyUid"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_copy"
                        android:layout_marginStart="4dp"
                        app:tint="#9E9E9E"
                        android:background="?selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLoanAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSettle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settle Debt"
            android:layout_marginTop="12dp"
            app:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"/>

        <LinearLayout
            android:id="@+id/llOverdueGuarantor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFEBEE"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OVERDUE: Guarantor Info"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvGuarantorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name: Loading..."
                android:textColor="#C62828"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvGuarantorPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phone: Loading..."
                android:textColor="#C62828"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>